<Window x:Class="GameSettingsParser.Views.Configuration.ConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewModels="clr-namespace:GameSettingsParser.ViewModels.Configuration"
        xmlns:mvvm="http://prismlibrary.com/"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:dt="clr-namespace:GameSettingsParser.DataTemplates"
        mvvm:ViewModelLocator.AutoWireViewModel="False"
        d:DataContext="{d:DesignInstance Type=viewModels:ConfigurationDialogViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="ConfigurationDialog" Height="450" Width="800">
    <Grid Margin="4">
        <Grid.Resources>
            <!-- Default settings for controls -->
            <Style TargetType="{x:Type Label}">
                <Setter Property="Margin" Value="0,3,5,5" />
                <Setter Property="Padding" Value="0,0,0,5" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="25" />
                <Setter Property="Margin" Value="5,0,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" 
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            <TreeView ItemsSource="{Binding TreeViewItems}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate x:Key="ConfigTemplate" DataType="{x:Type viewModels:IConfigurationTreeViewItem}">
                        <Label Margin="0" Padding="0" Content="{Binding DisplayName}"/>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate x:Key="SectionTemplate" DataType="{x:Type viewModels:ConfigurationSectionViewModel}" ItemsSource="{Binding TreeViewItems}">
                        <Label Margin="0" Padding="0" Content="{Binding DisplayName}"/>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemTemplateSelector>
                    <dt:ConfigurationTreeViewTemplateSelector ConfigTemplate="{StaticResource ConfigTemplate}" SectionTemplate="{StaticResource SectionTemplate}"/>
                </TreeView.ItemTemplateSelector>
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectedItemChanged">
                        <b:InvokeCommandAction Command="{Binding OnTreeViewSelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </TreeView>
        </Grid>
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="4" Background="LightGray"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch"  />
        <Grid Grid.Row="0" Grid.Column="2"
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            <Border BorderBrush="Gray" BorderThickness="1">
                <ContentPresenter Content="{Binding SelectedConfiguration}" ContentTemplateSelector="{x:Static dt:ConfigurationTemplateSelector.Instance}"/>
            </Border>
        </Grid>
        
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 10, 0, 4">
            <Button Command="{Binding OnOkCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" IsDefault="True">OK</Button>
            <Button Command="{Binding OnCancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" IsCancel="True">Cancel</Button>
            <Button Command="{Binding OnApplyCommand}" IsEnabled="{Binding HasChanges}">Apply</Button>
        </StackPanel>
    </Grid>
</Window>
